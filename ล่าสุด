# ==================================
# คลาสทัชสกรีน XPT2046
# ==================================
class XPT2046:
    def __init__(self, spi, cs):
        self.spi = spi
        self.cs = cs
        self.cs.value(1)
        self.x_min = 360
        self.x_max = 3650
        self.y_min = 280
        self.y_max = 3700
        self.w = 480
        self.h = 320
        self.threshold = 350
        self.last_pos = None

    def _read_raw(self, cmd):
        self.cs.value(0)
        res = self.spi.read(3, cmd)
        self.cs.value(1)
        return ((res[1] << 8) | res[2]) >> 3

    def get_touch(self):
        rx = self._read_raw(0xD0)
        ry = self._read_raw(0x90)

        if rx < self.threshold or ry < self.threshold:
            self.last_pos = None
            return None

        x = int(self.w - ((rx - self.x_min) * self.w / (self.x_max - self.x_min)))
        y = int(self.h - ((ry - self.y_min) * self.h / (self.y_max - self.y_min)))

        x = max(0, min(x, self.w - 1))
        y = max(0, min(y, self.h - 1))

        pos = (x, y)
        if pos == self.last_pos:
            return None
        self.last_pos = pos
        return pos

    def is_in(self, point, x, y, w, h):
        return point and (x <= point[0] <= x + w) and (y <= point[1] <= y + h)

# ==================================
# ฮาร์ดแวร์และการเริ่มต้นระบบ
# ==================================
TFT_CS   = Pin(4, Pin.OUT)
TFT_RST  = Pin(5, Pin.OUT)
TFT_DC   = Pin(6, Pin.OUT)
TFT_SCK  = Pin(7)
TFT_MOSI = Pin(8)
TFT_MISO = Pin(9)
TFT_BL   = Pin(10, Pin.OUT)

TP_SCK   = Pin(11)
TP_CS    = Pin(12, Pin.OUT)
TP_MOSI  = Pin(13)
TP_MISO  = Pin(14)

spi_tft = SPI(1, baudrate=6000000, polarity=0, phase=0, sck=TFT_SCK, mosi=TFT_MOSI, miso=TFT_MISO)
spi_tp  = SPI(2, baudrate=1200000, polarity=0, phase=0, sck=TP_SCK, mosi=TP_MOSI, miso=TP_MISO)

print("=== STARTING JARVIS SYSTEM ===")
TFT_BL.value(1)
time.sleep_ms(500)
tft = ILI9488(spi_tft, TFT_CS, TFT_DC, TFT_RST)
time.sleep_ms(1000)
touch = XPT2046(spi_tp, TP_CS)
time.sleep_ms(500)

current_screen = "main"
drawn = False

# ==================================
# ลูปการทำงานหลัก
# ==================================
while True:
    gc.collect()

    if not drawn:
        if current_screen == "main":
            tft.draw_main_menu()
        elif current_screen == "info":
            tft.draw_system_info()
        elif current_screen == "shell":
            tft.draw_shell_screen()
        drawn = True

    p = touch.get_touch()
    if p:
        changed = False
        if current_screen == "main":
            if touch.is_in(p, 25, 40, 205, 75):
                tft.draw_rect(25,40,205,75,0,120,220)
                tft.draw_text(75,62,"MENU",scale=2)
                time.sleep_ms(150)
                drawn = False
                changed = True
            elif touch.is_in(p, 265, 40, 205, 75):
                tft.draw_rect(265,40,205,75,0,160,90)
                tft.draw_text(295,62,"AI JARVIS",scale=2)
                time.sleep_ms(150)
                drawn = False
                changed = True
            elif touch.is_in(p, 25, 125, 205, 75):
                tft.draw_rect(25,125,205,75,200,160,60)
                tft.draw_text(65,147,"SETTINGS",scale=2)
                time.sleep_ms(150)
                drawn = False
                changed = True
            elif touch.is_in(p, 265, 125, 205, 75):
                tft.draw_rect(265,125,205,75,160,60,130)
                tft.draw_text(300,147,"CONFIG",scale=2)
                time.sleep_ms(150)
                drawn = False
                changed = True
            elif touch.is_in(p, 25, 210, 205, 75):
                current_screen = "info"
                drawn = False
                changed = True
            elif touch.is_in(p, 265, 210, 205, 75):
                current_screen = "shell"
                drawn = False
                changed = True
        elif current_screen == "info":
            if touch.is_in(p, 180, 280, 120, 32):
                current_screen = "main"
                drawn = False
                changed = True
        elif current_screen == "shell":
            if touch.is_in(p, 180, 280, 120, 32):
                current_screen = "main"
                drawn = False
                changed = True

        if changed:
            time.sleep_ms(200)

    time.sleep_ms(60)







