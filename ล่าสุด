            'Y': [0x66,0x66,0x3C,0x18,0x18,0x18,0x18,0x00],
            'Z': [0x7E,0x66,0x0C,0x18,0x30,0x66,0x7E,0x00],
            '-': [0x00,0x00,0x00,0x3C,0x00,0x00,0x00,0x00],
            '_': [0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x7E],
            '/': [0x02,0x06,0x0C,0x18,0x30,0x60,0x40,0x00],
        }
        if ch not in font:
            return
        data = font[ch]
        for row in range(8):
            for col in range(8):
                if data[row] & (1 << (7 - col)):
                    for sy in range(scale):
                        for sx in range(scale):
                            self.draw_pixel(x + col*scale + sx, y + row*scale + sy, r, g, b)

    def draw_text(self, x, y, text, r=255, g=255, b=255, scale=1):
        offset = 0
        for ch in text.upper():
            self.draw_char(x + offset, y, ch, r, g, b, scale)
            offset += 8 * scale + 1

