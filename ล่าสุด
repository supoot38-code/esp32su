from machine import Pin, SPI
import time, gc

def rgb(r, g, b):
    return bytes((r & 0xFC, g & 0xFC, b & 0xFC))

# ==================================
# คลาสจอแสดงผล ILI9488
# ==================================
class ILI9488:
    def __init__(self, spi, cs, dc, rst):
        self.spi = spi
        self.cs = cs
        self.dc = dc
        self.rst = rst
        self.w = 480
        self.h = 320
        self.cs.value(1)
        self.dc.value(1)
        self.rst.value(1)
        self._reset()
        self._init()

    def _reset(self):
        self.rst.value(0)
        time.sleep_ms(200)
        self.rst.value(1)
        time.sleep_ms(300)

    def _cmd(self, cmd):
        self.dc.value(0)
        self.cs.value(0)
        self.spi.write(bytes([cmd]))
        self.cs.value(1)

    def _data(self, data):
        self.dc.value(1)
        self.cs.value(0)
        self.spi.write(data if isinstance(data, bytes) else bytes([data]))
        self.cs.value(1)

    def _init(self):
        self._cmd(0x01)
        time.sleep_ms(300)
        self._cmd(0x11)
        time.sleep_ms(200)
        self._cmd(0x36)
        self._data(0x28)
        self._cmd(0x3A)
        self._data(0x66)
        self._cmd(0x2A)
        self._data(b'\x00\x00\x01\xDF')
        self._cmd(0x2B)
        self._data(b'\x00\x00\x01\x3F')
        self._cmd(0xC0)
        self._data(0x15)
        self._data(0x15)
        self._cmd(0xC1)
        self._data(0x45)
        self._cmd(0x29)
        time.sleep_ms(200)

    def set_window(self, x0, y0, x1, y1):
        x0 = max(0, min(x0, self.w - 1))
        y0 = max(0, min(y0, self.h - 1))
        x1 = max(x0, min(x1, self.w - 1))
        y1 = max(y0, min(y1, self.h - 1))
        self._cmd(0x2A)
        self._data(bytes([x0>>8, x0&0xFF, x1>>8, x1&0xFF]))
        self._cmd(0x2B)
        self._data(bytes([y0>>8, y0&0xFF, y1>>8, y1&0xFF]))
        self._cmd(0x2C)

    def fill(self, r=255, g=255, b=255):
        c = rgb(r,g,b)
        self.set_window(0, 0, self.w-1, self.h-1)
        buf = c * self.w
        for _ in range(self.h):
            self._data(buf)

    def draw_pixel(self, x, y, r, g, b):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.set_window(x, y, x, y)
            self._data(rgb(r, g, b))

    def draw_rect(self, x, y, w, h, r, g, b, border=1):
        c = rgb(r,g,b)
        self.set_window(x, y, x+w-1, y+h-1)
        buf = c * w
        for _ in range(h):
            self._data(buf)
        if border:
            cb = rgb(255,255,255)
            self.set_window(x, y, x+w-1, y); self._data(cb * w)
            self.set_window(x, y+h-1, x+w-1, y+h-1); self._data(cb * w)
            self.set_window(x, y, x, y+h-1); self._data(bytes([cb[0]] * h))
            self.set_window(x+w-1, y, x+w-1, y+h-1); self._data(bytes([cb[0]] * h))

