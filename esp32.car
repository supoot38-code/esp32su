# ✅======================
# ✅ ส่วนเพิ่มใหม่: ระบบ AI เสริม (ไม่แตะโค้ดเดิม)
# ✅======================
AI_SECOND_READY = False
AI_SECOND_PAUSED = False
AI_LAST_ACTIVITY = 0
AI_IDLE_TIMEOUT = 30000  # ถ้าไม่มีการทำงาน 30 วินาที จะพักตัวเอง
AI_SHOCK_COUNT = 0
AI_LAST_SHOCK_TIME = 0
AI_ANALYSIS_INTERVAL = 5000  # วิเคราะห์ทุก 5 วินาทีเมื่อพร้อม

def ai_second_init():
    """เริ่มต้นระบบ AI เสริม ทำครั้งเดียวเมื่อทุกอย่างพร้อม"""
    global AI_SECOND_READY
    if AI_SECOND_READY:
        return
    # เริ่มทำงานเมื่อระบบหลักและอุปกรณ์พื้นฐานทำงานครบ
    if AUDIO_READY and SHOCK_CHECK_DONE and RELAY_CHECK_DONE:
        AI_SECOND_READY = True
        print("[AI-SECOND] >>> เริ่มต้นระบบวิเคราะห์เสริมพร้อมใช้งาน")
    else:
        AI_SECOND_READY = False
        print("[AI-SECOND] >>> รอระบบหลักพร้อมก่อนเริ่มทำงาน")

def ai_second_check_status():
    """ตรวจสอบว่าควรทำงานต่อหรือหยุด/พักตัวเอง"""
    global AI_SECOND_PAUSED, AI_LAST_ACTIVITY
    if not AI_SECOND_READY:
        return False
    # หยุดเองถ้าไม่มีอะไรเกิดขึ้นนานเกินไป
    current_time = time.ticks_ms()
    if time.ticks_diff(current_time, AI_LAST_ACTIVITY) > AI_IDLE_TIMEOUT:
        if not AI_SECOND_PAUSED:
            AI_SECOND_PAUSED = True
            print("[AI-SECOND] >>> ไม่มีกิจกรรม - พักการทำงานชั่วคราว")
        return False
    # กลับมาทำงานทันทีเมื่อมีอะไรเกิดขึ้น
    if AI_SECOND_PAUSED:
        AI_SECOND_PAUSED = False
        print("[AI-SECOND] >>> ตรวจพบกิจกรรม - กลับมาทำงานปกติ")
    return True

def ai_second_process_shock():
    """วิเคราะห์ข้อมูลจากเซ็นเซอร์สะเทือน แยกงาน ไม่ไปแทรกคำสั่งหลัก"""
    global AI_SHOCK_COUNT, AI_LAST_SHOCK_TIME, AI_LAST_ACTIVITY
    if not SHOCK_SENSOR_READY or verify_owner():
        return
    current = time.ticks_ms()
    # นับจำนวนครั้งและช่วงเวลา
    if time.ticks_diff(current, AI_LAST_SHOCK_TIME) < 3000:
        AI_SHOCK_COUNT += 1
    else:
        AI_SHOCK_COUNT = 1
    AI_LAST_SHOCK_TIME = current
    AI_LAST_ACTIVITY = current
    # ส่งแค่ข้อสังเกต ไม่สั่งการเอง
    if AI_SHOCK_COUNT >= SHOCK_TRIGGER_THRESHOLD:
        tts_thai_from_network("ตรวจพบการสั่นสะเทือนหลายครั้ง กำลังเฝ้าดูสถานการณ์")
        AI_SHOCK_COUNT = 0

def ai_second_run():
    """ลูปการทำงานหลักของ AI เสริม"""
    if not AI_SECOND_READY:
        ai_second_init()
        return
    if not ai_second_check_status():
        return
    # ทำงานเฉพาะช่วงว่าง ไม่แย่งทรัพยากร
    if time.ticks_ms() % AI_ANALYSIS_INTERVAL < 200:
        ai_second_process_shock()

# ======================
# ฟังก์ชันตรวจสอบเดิม - คงเดิมทั้งหมด
# ======================
def detect_audio_once():
    global MIC_PIN, SPEAKER_PINS, AUDIO_READY, AUDIO_CHECK_DONE
    if AUDIO_CHECK_DONE:
        return
    print("[SHELL] >>> กำลังตรวจสอบอุปกรณ์เสียง...")
    MIC_PIN = None
    SPEAKER_PINS = []
    AUDIO_READY = False

    for pin_num in SAFE_PINS:
        try:
            if 32 <= pin_num <= 35:
                adc = machine.ADC(machine.Pin(pin_num))
                adc.atten(machine.ADC.ATTN_11DB)
                val = adc.read()
                if 100 < val < 3900:
                    MIC_PIN = pin_num
                    break
            else:
                p = machine.Pin(pin_num, machine.Pin.IN)
                _ = p.value()
                MIC_PIN = pin_num
                break
        except:
            continue

    if MIC_PIN is not None:
        SPEAKER_PINS = [p for p in SAFE_PINS if p != MIC_PIN]
        AUDIO_READY = True
        print(f"[SHELL] >>> พบอุปกรณ์เสียง | ไมค์: ขา {MIC_PIN} | ลำโพง: ขา {SPEAKER_PINS}")
    else:
        print("[SHELL] >>> ไม่พบอุปกรณ์เสียง - ข้ามขั้นตอนนี้")
    
    AUDIO_CHECK_DONE = True

def detect_camera_once():
    global CAM_CONFIG, CAM_READY, CAM_CHECK_DONE, FACE_READY
    if CAM_CHECK_DONE:
        return
    print("[SHELL] >>> กำลังตรวจสอบกล้อง...")
    CAM_CONFIG = None
    CAM_READY = False
    FACE_READY = False

    for pin_set in ALLOWED_CAM_PINS:
        try:
            p = machine.Pin(pin_set, machine.Pin.IN)
            _ = p.value()
            CAM_CONFIG = {"pins": pin_set}
            CAM_READY = True
            FACE_READY = True
            print(f"[SHELL] >>> พบกล้องที่ขา: {pin_set}")
            break
        except:
            continue

    if not CAM_READY:
        print("[SHELL] >>> ไม่พบกล้อง - ข้ามขั้นตอนนี้ ระบบจดจำไม่ทำงาน")
    
    CAM_CHECK_DONE = True

