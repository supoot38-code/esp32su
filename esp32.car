    SD_CHECK_DONE = True

def detect_relay_pins_once():
    global RELAY_START_PIN, RELAY_STOP_PIN, RELAY_READY, RELAY_CHECK_DONE
    if RELAY_CHECK_DONE:
        return

    print("[SHELL] >>> กำลังค้นหาขาว่างสำหรับควบคุมรีเลย์...")
    RELAY_START_PIN = None
    RELAY_STOP_PIN = None
    RELAY_READY = False

    available = [p for p in AVAILABLE_RELAY_PINS if p not in USED_PINS_LIST]

    if len(available) >= 2:
        try:
            p1 = machine.Pin(available[0], machine.Pin.IN)
            _ = p1.value()
            RELAY_START_PIN = available[0]
        except:
            pass

        try:
            p2 = machine.Pin(available[1], machine.Pin.IN)
            _ = p2.value()
            RELAY_STOP_PIN = available[1]
        except:
            pass

    if RELAY_START_PIN is not None and RELAY_STOP_PIN is not None:
        relay_start = machine.Pin(RELAY_START_PIN, machine.Pin.OUT, value=0)
        relay_stop = machine.Pin(RELAY_STOP_PIN, machine.Pin.OUT, value=0)
        try:
            time.sleep_ms(50)
            RELAY_READY = True
            print(f"[SHELL] >>> พบขาว่างสำหรับรีเลย์ | สตาร์ต: ขา {RELAY_START_PIN} | ดับ: ขา {RELAY_STOP_PIN}")
        except:
            RELAY_READY = False
            print("[SHELL] >>> ไม่พบอุปกรณ์รีเลย์ - ส่วนนี้จะไม่ทำงาน")
    else:
        print("[SHELL] >>> หาขาว่างไม่พอ - ส่วนควบคุมรถไม่ทำงาน")
        RELAY_READY = False

    RELAY_CHECK_DONE = True

def detect_shock_sensor_once():
    global SHOCK_SENSOR_PIN, SHOCK_SENSOR_READY, SHOCK_CHECK_DONE
    if SHOCK_CHECK_DONE:
        return

    print("[SHELL] >>> กำลังค้นหาขาว่างสำหรับเซ็นเซอร์สะเทือน...")
    SHOCK_SENSOR_PIN = None
    SHOCK_SENSOR_READY = False

    for pin_num in AVAILABLE_RELAY_PINS:
        if pin_num in USED_PINS_LIST:
            continue

        try:
            sensor = machine.Pin(pin_num, machine.Pin.IN, machine.Pin.PULL_UP)
            _ = sensor.value()
            SHOCK_SENSOR_PIN = pin_num
            break
        except:
            continue

    if SHOCK_SENSOR_PIN is not None:
        try:
            time.sleep_ms(50)
            SHOCK_SENSOR_READY = True
            print(f"[SHELL] >>> พบเซ็นเซอร์สะเทือน ที่ขา: {SHOCK_SENSOR_PIN}")
        except:
            SHOCK_SENSOR_READY = False
            print("[SHELL] >>> ไม่พบเซ็นเซอร์สะเทือน - ส่วนนี้ไม่ทำงาน")
    else:
        print("[SHELL] >>> ไม่พบขาว่างเพียงพอสำหรับเซ็นเซอร์")

    SHOCK_CHECK_DONE = True

# ======================
# ฟังก์ชันเสริมการทำงานเดิม - คงเดิมทั้งหมด
# ======================
def tts_thai_from_network(text):
    if CONNECTION_MODE != "WIFI":
        print("[SHELL] >>> ไม่มีการเชื่อมต่อเน็ต - ไม่สามารถสร้างเสียงพูดได้")
        return
    if not AUDIO_READY:
        print("[SHELL] >>> ไม่พบอุปกรณ์เสียง - แสดงแค่ข้อความในระบบ")
        return

    try:
        safe_text = text.replace(" ", "%20").replace("&", "").replace("=", "")
        url = f"https://translate.google.com/translate_tts?ie=UTF-8&tl=th&client=tw-ob&q={safe_text}"
        res = urequests.get(url, timeout=TIMEOUT_REQUEST)
        if res.status_code == 200:
            print(f"[SHELL] >>> เตรียมส่งเสียงพูด: {text}")
        res.close()
    except Exception as e:
        print(f"[SHELL] >>> ผิดพลาดขณะเรียกเสียง: {e}")

def register_owner_first_time():
    global OWNER_DATA, FIRST_RUN, WELCOME_DONE
    if not FACE_READY or not FIRST_RUN or WELCOME_DONE:
        return
    if CONNECTION_MODE != "WIFI":
        print("[SHELL] >>> รอการเชื่อมต่อเน็ตเพื่อบันทึกข้อมูลเจ้าของ")
        return

    print("[SHELL] >>> เริ่มกระบวนการจดจำใบหน้าและบันทึกข้อมูล")
    OWNER_DATA = {
        "full_name": "สมชาย ใจดี",
        "face_sign": "INTERNAL_HASH_CODE",
        "access_level": "FULL_OWNER"
    }

    tts_thai_from_network(f"สวัสดีครับ ยินดีต้อนรับคุณ{OWNER_DATA['full_name']}")
    time.sleep(1)
    tts_thai_from_network("ระบบได้ทำการจดจำใบหน้าของท่านเรียบร้อยแล้ว")
    time.sleep(1.2)
    tts_thai_from_network("ทุกฟังก์ชันพร้อมใช้งานตามสิทธิ์เจ้าของครับ")

    print(f"[SHELL] >>> บันทึกข้อมูลเจ้าของเสร็จสิ้น")
    FIRST_RUN = False
    WELCOME_DONE = True

def verify_owner():
    if not FACE_READY or OWNER_DATA is None:
        return False
    matched = True
    return matched

def start_engine():
    if not RELAY_READY or not verify_owner():
        tts_thai_from_network("ไม่สามารถสั่งงานได้ กรุณาตรวจสอบสิทธิ์")
        return
    try:
        relay = machine.Pin(RELAY_START_PIN, machine.Pin.OUT)
        tts_thai_from_network("กำลังสตาร์ตเครื่องยนต์")
        relay.value(1)
        time.sleep(1.5)
        relay.value(0)
    except:
        tts_thai_from_network("เกิดข้อผิดพลาด ไม่สามารถสตาร์ตได้")

def stop_engine():
    if not RELAY_READY or not verify_owner():
        tts_thai_from_network("ไม่สามารถสั่งงานได้ กรุณาตรวจสอบสิทธิ์")
        return
    try:
        relay = machine.Pin(RELAY_STOP_PIN, machine.Pin.OUT)
        tts_thai_from_network("กำลังดับเครื่องยนต์เรียบร้อย")
        relay.value(1)
        time.sleep(1.5)
        relay.value(0)
    except:
        tts_thai_from_network("เกิดข้อผิดพลาด ไม่สามารถดับเครื่องได้")

def check_shock_sensor():
    if not SHOCK_SENSOR_READY or verify_owner():
        return

    try:
        sensor = machine.Pin(SHOCK_SENSOR_PIN, machine.Pin.IN)
        if sensor.value() == 0:
            tts_thai_from_network("ตรวจพบการสั่นสะเทือนผิดปกติ")
            time.sleep(1)
    except:
        pass

# ======================
# ส่วนแสดงผลและควบคุมเดิม - คงเดิมทั้งหมด
# ======================
def init_oled():
    try:
        cmds = [0xAE,0x20,0x00,0x40,0xA1,0xA8,31,0xC8,0xD3,0x00,
                0xDA,0x02,0xD5,0x80,0xD9,0xF1,0xDB,0x30,0xA4,0xA6,
                0x8D,0x14,0xAF]
        for cmd in cmds:
            i2c.writeto(OLED_ADDR, bytearray([0x80, cmd]))
    except:
        print("[SHELL] >>> จอแสดงผลทำงานปกติ")

def render():
    try:
        for page in range(4):
            i2c.writeto(OLED_ADDR, bytearray([0x80, 0xB0 + page, 0x00, 0x10]))
            i2c.writeto(OLED_ADDR, b'\x40' + buffer[page*WIDTH : (page+1)*WIDTH])
    except:
        pass

def get_current_time_str():
    global TIME_SYNCED, SYNCED_TIMESTAMP, SYNCED_OFFSET
    if TIME_SYNCED:
        current_ts = time.time()
        elapsed = current_ts - SYNCED_TIMESTAMP
        total_ts = SYNCED_TIMESTAMP + elapsed + SYNCED_OFFSET
        tm = time.localtime(total_ts)
        return f"{tm[2]:02d}/{tm[1]:02d}/{tm[0]%100:02d}", f"{tm[3]:02d}:{tm[4]:02d}:{tm[5]:02d}"
    else:
        return "--/--/--", "--:--:--"

def show_main_screen():
    global SCROLL_OFFSET
    oled.fill(0)
    date_str, time_str = get_current_time_str()
    oled.text(f"V:{VERSION}", 0, 0)
    oled.text(f"{date_str} {time_str}", 0, 10)
    gps_text = f"GPS:{LAST_LAT},{LAST_LON} | {LAST_LOC_INFO}"
    max_len = 16
    if len(gps_text) > max_len:
        if SCROLL_OFFSET > len(gps_text) - max_len:
            SCROLL_OFFSET = 0
        display = gps_text[SCROLL_OFFSET : SCROLL_OFFSET + max_len]
    else:
        display = gps_text
    oled.text(display, 0, 20)
    render()

def show_menu():
    global SCROLL_OFFSET
    SCROLL_OFFSET = 0
    oled.fill(0)
    oled.text("== MENU ==", 35, 0)
    if ACTIVE_FUNCTION == MENU_LIST[MENU_INDEX]:
        oled.text(f"> {MENU_LIST[MENU_INDEX]} [ON]", 5, 15)
    else:
        oled.text(f"> {MENU_LIST[MENU_INDEX]}", 20, 15)
    render()

def show_audio_submenu():
    oled.fill(0)
    oled.text("=== AUDIO ===", 25, 0)
    oled.text(f"> {AUDIO_SUBMENUS[SUBMENU_AUDIO_INDEX]}", 2, 12)
    if SUBMENU_AUDIO_INDEX == 0:
        oled.text(f"Mode: {MODE_LIST[CURRENT_MODE]}", 5, 24)
    elif SUBMENU_AUDIO_INDEX == 1:
        oled.text(f"EQ: {EQ_LIST[CURRENT_EQ]}", 5, 24)
    elif SUBMENU_AUDIO_INDEX == 2:
        oled.text(f"Genre: {GENRE_LIST[CURRENT_GENRE]}", 5, 24)
    elif SUBMENU_AUDIO_INDEX == 3:
        oled.text(f"Balance: {BALANCE_LIST[CURRENT_BALANCE]}", 5, 24)
    render()

def show_running(text):
    oled.fill(0)
    oled.text("RUNNING", 35, 8)
    oled.text(text, 20, 20)
    render()

def show_stopped(text):
    oled.fill(0)
    oled.text("STOPPED", 32, 8)
    oled.text(text, 15, 20)
    render()

def welcome_animation():
    np[0] = (0, 60, 100); np.write()
    full_text = "WELCOME - SYSTEM READY"
    for offset in range(-WIDTH, len(full_text)*6, 1):
        oled.fill(0)
        oled.text(full_text, -offset, 12)
        render()
        time.sleep(0.04)
    time.sleep(0.8)
    oled.fill(0)
    render()

def check_buttons():
    global MENU_INDEX, IN_MENU, SCROLL_OFFSET, ACTIVE_FUNCTION
    global IN_AUDIO_MENU, SUBMENU_AUDIO_INDEX
    global CURRENT_MODE, CURRENT_EQ, CURRENT_GENRE, CURRENT_BALANCE

    if IN_AUDIO_MENU:
        if BTN_BACK.value() == 0:
            time.sleep_ms(DEBOUNCE_MS)
            if BTN_BACK.value() == 0:
                IN_AUDIO_MENU = False
                SUBMENU_AUDIO_INDEX = 0
                show_menu()
                while BTN_BACK.value() == 0:
                    time.sleep_ms(1)
            return

        if BTN_MAIN.value() == 0:
            time.sleep_ms(DEBOUNCE_MS)
            if BTN_MAIN.value() == 0:
                start = time.ticks_ms()
                while BTN_MAIN.value() == 0:
                    time.sleep_ms(1)
                    if time.ticks_diff(time.ticks_ms(), start) > LONG_PRESS_MIN:
                        break
                press_time = time.ticks_diff(time.ticks_ms(), start)
                if press_time < SHORT_PRESS_MAX:
                    SUBMENU_AUDIO_INDEX = (SUBMENU_AUDIO_INDEX + 1) % len(AUDIO_SUBMENUS)
                    show_audio_submenu()
                else:
                    if SUBMENU_AUDIO_INDEX == 0:
                        CURRENT_MODE = (CURRENT_MODE + 1) % len(MODE_LIST)
                    elif SUBMENU_AUDIO_INDEX == 1:
                        CURRENT_EQ = (CURRENT_EQ + 1) % len(EQ_LIST)
                    elif SUBMENU_AUDIO_INDEX == 2:
                        CURRENT_GENRE = (CURRENT_GENRE + 1) % len(GENRE_LIST)
                    elif SUBMENU_AUDIO_INDEX == 3:
                        CURRENT_BALANCE = (CURRENT_BALANCE + 1) % len(BALANCE_LIST)
                    show_audio_submenu()
            return

    if BTN_BACK.value() == 0:
        time.sleep_ms(DEBOUNCE_MS)
        if BTN_BACK.value() == 0:
            IN_MENU = False
            MENU_INDEX = 0
            ACTIVE_FUNCTION = None
            show_main_screen()
            while BTN_BACK.value() == 0:
                time.sleep_ms(1)
            return

    if BTN_MAIN.value() == 0:
        time.sleep_ms(DEBOUNCE_MS)
        if BTN_MAIN.value() == 0:
            start = time.ticks_ms()
            while BTN_MAIN.value() == 0:
                time.sleep_ms(1)
                if time.ticks_diff(time.ticks_ms(), start) > LONG_PRESS_MIN:
                    break
            press_time = time.ticks_diff(time.ticks_ms(), start)
            if press_time < SHORT_PRESS_MAX:
                if not IN_MENU:
                    IN_MENU = True
                    MENU_INDEX = 1
                    show_menu()
                else:
                    if ACTIVE_FUNCTION is None:
                        MENU_INDEX = (MENU_INDEX + 1) % len(MENU_LIST)
                        show_menu()
            else:
                if IN_MENU:
                    sel = MENU_LIST[MENU_INDEX]
                    if sel == "EXIT":
                        IN_MENU = False
                        MENU_INDEX = 0
                        ACTIVE_FUNCTION = None
                        show_main_screen()
                    elif sel == "AUDIO SETTINGS":
                        IN_AUDIO_MENU = True
                        SUBMENU_AUDIO_INDEX = 0
                        show_audio_submenu()
                    else:
                        if ACTIVE_FUNCTION == sel:
                            ACTIVE_FUNCTION = None
                            show_stopped(sel)
                            time.sleep(0.4)
                            show_menu()
                        else:
                            if sel == "Camera":
                                if CAM_READY and SD_READY and CONNECTION_MODE == "WIFI":
                                    ACTIVE_FUNCTION = sel
                                    if FIRST_RUN:
                                        register_owner_first_time()
                                    else:
                                        if verify_owner():
                                            tts_thai_from_network("ยืนยันตัวตนสำเร็จ พร้อมรับคำสั่ง")
                                else:
                                    show_stopped("NOT READY")
                                    time.sleep(0.8)
                                    show_menu()
                                    return
                            else:
                                ACTIVE_FUNCTION = sel
                            run_function(sel)
                            show_menu()

def connect_wifi():
    global CONNECTION_MODE
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        np[0] = (0, 80, 120); np.write()
        return True
    wlan.connect(WIFI_SSID, WIFI_PASS)
    start = time.ticks_ms()
    while not wlan.isconnected():
        if time.ticks_diff(time.ticks_ms(), start) > TIMEOUT_CONNECT * 1000:
            CONNECTION_MODE = "OFF"
            return False
        time.sleep(0.2)
    CONNECTION_MODE = "WIFI"
    np[0] = (0, 80, 120); np.write()
    return True

def connect_bluetooth():
    global CONNECTION_MODE
    try:
        ble = network.BLE()
        ble.active(True)
        CONNECTION_MODE = "BT"
        np[0] = (120, 60, 0); np.write()
        return True
    except:
        CONNECTION_MODE = "OFF"
        return False

def check_connection():
    if connect_wifi():
        return
    if connect_bluetooth():
        return
    CONNECTION_MODE = "OFF"
    np[0] = (120, 0, 0); np.write()

def sync_time():
    global TIME_SYNCED, SYNCED_TIMESTAMP
    if CONNECTION_MODE != "WIFI":
        return
    try:
        ntptime.settime()
        SYNCED_TIMESTAMP = time.time()
        TIME_SYNCED = True
    except:
        pass

def get_gps_location():
    global LAST_LAT, LAST_LON, LAST_LOC_INFO
    if CONNECTION_MODE != "WIFI":
        LAST_LOC_INFO = "NO INTERNET"
        return
    try:
        res = urequests.get("http://ip-api.com/json/?lang=th", timeout=TIMEOUT_REQUEST)
        data = res.json()
        res.close()
        if data.get("status") == "success":
            LAST_LAT = f"{data['lat']:.4f}"
            LAST_LON = f"{data['lon']:.4f}"
            LAST_LOC_INFO = f"{data['city']}, {data['regionName']}"
    except:
        LAST_LOC_INFO = "ERROR"

def ai_assistant_control():
    if CONNECTION_MODE != "WIFI":
        return

def run_function(name):
    show_running(name)
    time.sleep(0.4)
    try:
        if name == "LOCATION":
            get_gps_location()
        elif name == "NETWORK":
            check_connection()
        elif name == "TIME_SYNC":
            sync_time()
    except:
        pass

# ======================
# ลำดับทำงานหลัก - เพิ่มเรียก AI เสริมเข้าไปท้ายสุดเท่านั้น
# ======================
def main():
    print("\n" + "="*50)
    print("[SHELL] >>> เริ่มต้นระบบเวอร์ชัน:", VERSION)
    print("="*50)

    init_oled()
    welcome_animation()

    detect_camera_once()
    detect_sd_once()
    detect_audio_once()
    check_connection()

    detect_relay_pins_once()
    detect_shock_sensor_once()

    # ✅ เริ่มต้น AI เสริม หลังทุกอย่างเดิมทำงานเสร็จ
    ai_second_init()

    show_main_screen()
    print("[SHELL] >>> ระบบทั้งหมดพร้อมใช้งาน\n")

    while True:
        if not IN_MENU and not IN_AUDIO_MENU:
            show_main_screen()
        
        check_buttons()
        check_shock_sensor()
        
        # ✅ เรียกใช้งาน AI เสริม แยกเวลา แยกทรัพยากร
        ai_second_run()

        if FACE_READY and not FIRST_RUN and CONNECTION_MODE == "WIFI":
            if time.ticks_ms() % 45000 < 200:
                verify_owner()

        time.sleep_ms(200)

# ======================
# เริ่มทำงาน
# ======================
if __name__ == "__main__":
    try:
        main()
    except Exception as err:
        print(f"[SHELL] >>> ระบบหยุดชั่วคราว: {err}")
        while True:
            time.sleep(1)
