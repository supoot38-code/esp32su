class ILI9488:
    def __init__(self, spi, cs, dc, rst):
        self.spi = spi
        self.cs = cs
        self.dc = dc
        self.rst = rst
        self.w = 480
        self.h = 320
        self.cs.value(1)
        self.dc.value(1)
        self.rst.value(1)
        self._reset()
        self._init()

    def _reset(self):
        self.rst.value(0)
        time.sleep_ms(100)
        self.rst.value(1)
        time.sleep_ms(200)

    def _cmd(self, cmd):
        self.dc.value(0)
        self.cs.value(0)
        self.spi.write(bytes([cmd]))
        self.cs.value(1)

    def _data(self, data):
        self.dc.value(1)
        self.cs.value(0)
        self.spi.write(data if isinstance(data, bytes) else bytes([data]))
        self.cs.value(1)

    def _init(self):
        self._cmd(0x01)
        time.sleep_ms(200)
        self._cmd(0x11)
        time.sleep_ms(150)
        self._cmd(0x36)
        self._data(0x28)
        self._cmd(0x3A)
        self._data(0x66)
        self._cmd(0x2A)
        self._data(b'\x00\x00\x01\xDF')
        self._cmd(0x2B)
        self._data(b'\x00\x00\x01\x3F')
        self._cmd(0xC0)
        self._data(0x15)
        self._data(0x15)
        self._cmd(0xC1)
        self._data(0x45)
        self._cmd(0xC5)
        self._data(0x00)
        self._data(0x28)
        self._cmd(0xB1)
        self._data(0x00)
        self._data(0x18)
        self._cmd(0xB6)
        self._data(0x02)
        self._data(0x02)
        self._cmd(0x29)
        time.sleep_ms(100)

    def set_window(self, x0, y0, x1, y1):
        x0 = max(0, min(x0, self.w-1))
        y0 = max(0, min(y0, self.h-1))
        x1 = max(x0, min(x1, self.w-1))
        y1 = max(y0, min(y1, self.h-1))
        self._cmd(0x2A)
        self._data(bytes([x0>>8, x0&0xFF, x1>>8, x1&0xFF]))
        self._cmd(0x2B)
        self._data(bytes([y0>>8, y0&0xFF, y1>>8, y1&0xFF]))
        self._cmd(0x2C)

    def fill(self, r, g, b):
        self.set_window(0, 0, self.w-1, self.h-1)
        color = rgb666(r, g, b)
        buf = color * self.w
        for _ in range(self.h):
            self._data(buf)

    def draw_char(self, x, y, ch, scale=2, fg=(255,255,255), bg=(0,0,0)):
        code = ord(ch)
        if not 32 <= code <= 126:
            return 8 * scale
        idx = (code - 32) * 8
        fg_c = rgb666(*fg)
        bg_c = rgb666(*bg)
        for row in range(8):
            bits = FONT8x8[idx + row]
            py = y + row * scale
            if py >= self.h:
                break
            line = b''
            for col in range(8):
                px = fg_c if (bits & (0x80 >> col)) else bg_c
                line += px * scale
            line *= scale
            self.set_window(x, py, x + 8*scale - 1, py + scale - 1)
            self._data(line)
        return 8 * scale

    def draw_text(self, x, y, txt, scale=2, fg=(255,255,255), bg=(0,0,0)):
        for ch in txt:
            x += self.draw_char(x, y, ch, scale, fg, bg)

# --------------------------
# ส่วนจอสัมผัส XPT2046 ตรงขาตามที่ระบุ
# --------------------------
class XPT2046:
    CMD_X  = 0xD0
    CMD_Y  = 0x90
    Z_THRESHOLD = 400

    def __init__(self, spi, cs):
        self.spi = spi
        self.cs = cs
        self.cs.value(1)
        # ค่าปรับเทียบตำแหน่ง (แก้ตามเครื่องจริงได้)
        self.x_min = 200
        self.x_max = 3800
        self.y_min = 200
        self.y_max = 3800
        self.w = 480
        self.h = 320

    def _read_raw(self, cmd):
        self.cs.value(0)
        resp = self.spi.read(3, cmd)
        self.cs.value(1)
        val = ((resp[1] << 8) | resp[2]) >> 3
        return val

    def get_point(self):
        x = self._read_raw(self.CMD_X)
        y = self._read_raw(self.CMD_Y)
        if x < self.Z_THRESHOLD or y < self.Z_THRESHOLD:
            return None
        # แปลงค่าดิบให้ตรงกับขนาดจอ
        x = int((x - self.x_min) * self.w / (self.x_max - self.x_min))
        y = int((y - self.y_min) * self.h / (self.y_max - self.y_min))
        x = max(0, min(x, self.w - 1))
        y = max(0, min(y, self.h - 1))
        return (x, y)

# --------------------------
# เชื่อมต่อขาและเริ่มทำงาน
# --------------------------
# ขาจอ
TFT_CS   = Pin(4, Pin.OUT)
TFT_RST  = Pin(5, Pin.OUT)
TFT_DC   = Pin(6, Pin.OUT)
TFT_SCK  = Pin(7)
TFT_MOSI = Pin(8)
TFT_MISO = Pin(9)
TFT_BL   = Pin(10, Pin.OUT, value=1)

# ขาสัมผัส
TP_CLK   = Pin(11)
TP_CS    = Pin(12, Pin.OUT)
TP_MOSI  = Pin(13)
TP_MISO  = Pin(14)
TP_IRQ   = Pin(15, Pin.IN, Pin.PULL_UP)

# ใช้ SPI แยกกันเพื่อไม่ให้ชนกัน
spi_tft = SPI(1, baudrate=10_000_000, polarity=0, phase=0, sck=TFT_SCK, mosi=TFT_MOSI, miso=TFT_MISO)
spi_tp  = SPI(2, baudrate=2_000_000, polarity=0, phase=0, sck=TP_CLK, mosi=TP_MOSI, miso=TP_MISO)

# สร้างออบเจกต์
tft = ILI9488(spi_tft, cs=TFT_CS, dc=TFT_DC, rst=TFT_RST)
tp = XPT2046(spi_tp, cs=TP_CS)

# ทดสอบการทำงาน
tft.fill(0,0,0)
tft.draw_text(120, 150, "TOUCH TEST", scale=3, fg=(0,255,255))

# วนรอรับการสัมผัส
while True:
    pos = tp.get_point()
    if pos:
        x, y = pos
        tft.draw_text(5, 5, f"X:{x:3d} Y:{y:3d}  ", scale=2, fg=(255,255,0))
        # วาดจุดตรงที่แตะ
        tft.set_window(x, y, x+2, y+2)
        tft._data(rgb666(255,0,0) * 9)
    time.sleep_ms(50)

