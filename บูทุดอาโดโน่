#include "ESP_I2S.h"
#include "BluetoothA2DPSink.h"

const uint8_t I2S_SCK  = 26;  // BCLK
const uint8_t I2S_WS   = 25;  // LRC
const uint8_t I2S_DOUT = 22;  // DIN

I2SClass i2s;
BluetoothA2DPSink a2dp_sink(i2s);

void setup() {
  Serial.begin(115200);
  i2s.setPins(I2S_SCK, I2S_WS, I2S_DOUT);
  i2s.begin(I2S_MODE_STD, 44100, I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO, I2S_STD_SLOT_BOTH);
  a2dp_sink.start("ESP32 Speaker");
}

void loop() {
}
