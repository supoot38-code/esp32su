def check_buttons():
    global MENU_INDEX, IN_MENU, SCROLL_OFFSET, ACTIVE_FUNCTION

    # --- ปุ่มออก ขา 7 ---
    if BTN_BACK.value() == 0:
        time.sleep_ms(DEBOUNCE_MS)
        if BTN_BACK.value() == 0:
            print("[ปุ่ม] ออก/ย้อนกลับ")
            IN_MENU = False
            MENU_INDEX = 0
            ACTIVE_FUNCTION = None
            show_main_screen()
            while BTN_BACK.value() == 0:
                time.sleep_ms(1)
            return

    # --- ปุ่มหลัก ขา 6 ---
    if BTN_MAIN.value() == 0:
        time.sleep_ms(DEBOUNCE_MS)
        if BTN_MAIN.value() == 0:
            start = time.ticks_ms()
            while BTN_MAIN.value() == 0:
                time.sleep_ms(1)
                if time.ticks_diff(time.ticks_ms(), start) > 2000:
                    break
            press_time = time.ticks_diff(time.ticks_ms(), start)

            # กดสั้น: เข้าเมนู / เลื่อนรายการ
            if press_time < SHORT_PRESS_MAX:
                if not IN_MENU:
                    IN_MENU = True
                    MENU_INDEX = 1
                    ACTIVE_FUNCTION = None
                    print("[ปุ่ม] เข้าสู่เมนู")
                    show_menu()
                else:
                    if ACTIVE_FUNCTION is None:
                        MENU_INDEX = (MENU_INDEX + 1) % len(MENU_LIST)
                        print(f"[ปุ่ม] เลื่อนรายการ: {MENU_LIST[MENU_INDEX]}")
                        show_menu()

            # กดปานกลาง: เปิด / ปิด ฟังก์ชัน
            elif SHORT_PRESS_MAX <= press_time < LONG_PRESS_MIN:
                if IN_MENU:
                    sel = MENU_LIST[MENU_INDEX]
                    if sel == "EXIT":
                        IN_MENU = False
                        MENU_INDEX = 0
                        ACTIVE_FUNCTION = None
                        print("[ปุ่ม] ออกจากเมนู")
                        show_main_screen()
                    else:
                        if ACTIVE_FUNCTION == sel:
                            ACTIVE_FUNCTION = None
                            print(f"[ปุ่ม] ปิดการทำงาน: {sel}")
                            show_stopped(sel)
                            time.sleep(0.4)
                            show_menu()
                        else:
                            ACTIVE_FUNCTION = sel
                            print(f"[ปุ่ม] เปิดการทำงาน: {sel}")
                            run_function(sel)
                            show_menu()

