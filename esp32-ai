def connect_wifi():
    global CONNECTION_MODE
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        return True

    print("[เครือข่าย] กำลังเชื่อมต่อสัญญาณไวไฟ...")
    wlan.connect(WIFI_SSID, WIFI_PASS)
    start = time.ticks_ms()
    while not wlan.isconnected():
        if time.ticks_diff(time.ticks_ms(), start) > TIMEOUT_CONNECT * 1000:
            print("[เครือข่าย] ใช้เวลานานเกินไป ยกเลิกการเชื่อมต่อ")
            return False
        time.sleep(0.2)

    CONNECTION_MODE = "WIFI"
    np[0] = (0, 80, 120); np.write()
    print("[เครือข่าย] เชื่อมต่อไวไฟสำเร็จ")
    return True

def connect_bluetooth():
    global CONNECTION_MODE
    try:
        ble = network.BLE()
        ble.active(True)
        CONNECTION_MODE = "BT"
        np[0] = (120, 60, 0); np.write()
        print("[เครือข่าย] เปิดการทำงานบลูทูธสำเร็จ")
        return True
    except Exception as e:
        print(f"[เครือข่าย] ไม่สามารถเปิดบลูทูธได้: {e}")
        return False

def check_connection():
    if connect_wifi():
        return
    if connect_bluetooth():
        return
    CONNECTION_MODE = "OFF"
    np[0] = (120, 0, 0); np.write()
    print("[เครือข่าย] ไม่มีการเชื่อมต่อใดๆ")

