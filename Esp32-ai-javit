        "เสียงซ่าเกิดจากสาเหตุอะไร",
        "สัญญาณบาลานซ์คืออะไร"
    ]
    q_idx = 0

    while True:
        draw_main_screen()
        update_led_status()

        if BTN_ASK.value() == 0:
            time.sleep_ms(50)
            if BTN_ASK.value() == 0:
                clear_display()
                fb.text("กำลังคิด...", 0, 8)
                update_display()

                ans = ask_ai(questions[q_idx])
                q_idx = (q_idx + 1) % len(questions)

                clear_display()
                fb.text("💬 คำตอบ:", 0, 0)
                scroll_text(ans, 8)
                time.sleep(4)

        time.sleep_ms(300)

