# ==================================================
# 💡 ไฟแสดงสถานะ
# ==================================================
def breathe_effect(color, speed=0.03):
    for br in range(0, 80, 2):
        np[0] = (int(color[0]*br/100), int(color[1]*br/100), int(color[2]*br/100))
        np.write()
        time.sleep(speed)
    for br in range(80, -1, -2):
        np[0] = (int(color[0]*br/100), int(color[1]*br/100), int(color[2]*br/100))
        np.write()
        time.sleep(speed * 1.3)

def update_led_status():
    breathe_effect((0, 255, 0), 0.03) if CONNECTION_MODE == "WIFI" else breathe_effect((255, 0, 0), 0.03)

# ==================================================
# 📺 ระบบจอแสดงผล - สะอาด ไม่มีรอยค้าง
# ==================================================
def detect_display():
    global DISPLAY_ADDR
    addrs = i2c.scan()
    if 0x3C in addrs or 0x3D in addrs:
        DISPLAY_ADDR = 0x3C if 0x3C in addrs else 0x3D
        init = [
            0xAE,0xD5,0x80,0xA8,0x1F,0xD3,0x00,0x40,
            0x8D,0x14,0x20,0x00,0xA1,0xC8,0xDA,0x02,
            0x81,0x7F,0xD9,0xF1,0xDB,0x20,0xA4,0xA6,0xAF
        ]
        for cmd in init:
            i2c.writeto(DISPLAY_ADDR, bytearray([0x80, cmd]))
        return True
    return False

def update_display():
    for page in range(4):
        i2c.writeto(DISPLAY_ADDR, bytearray([0x80, 0xB0 + page, 0x00, 0x10]))
        i2c.writeto(DISPLAY_ADDR, b'\x40' + buffer[page*128 : (page+1)*128])

def clear_display():
    fb.fill(0)
    update_display()

def welcome_screen():
    clear_display()
    fb.text("🤖 AI JAVIT", 22, 0)
    fb.text("ระบบพร้อมใช้งาน", 18, 16)
    update_display()
    time.sleep(2)

def draw_main_screen():
    clear_display()
    d, t = get_time()
    fb.text("AI JAVIT", 0, 0)
    fb.text(f"{d} {t}", 0, 8)
    fb.text(f"WiFi: {'ON' if CONNECTION_MODE == "WIFI" else "OFF"}", 0, 20)
    update_display()

def scroll_text(text, y=8):
    if len(text) <= 16:
        fb.text(text, 0, y)
        update_display()
        return
    for i in range(len(text) - 14):
        fb.fill_rect(0, y, WIDTH, 8, 0)
        fb.text(text[i:i+16], 0, y)
        update_display()
        time.sleep(0.2)

# ==================================================
# 📶 เชื่อมต่อเน็ตและเวลา
# ==================================================
def connect_wifi():
    global CONNECTION_MODE
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        return True
    print("[WiFi] กำลังเชื่อมต่อ...")
    wlan.connect(WIFI_SSID, WIFI_PASS)
    timeout = 10
    while not wlan.isconnected() and timeout > 0:
        time.sleep(1)
        timeout -= 1
    CONNECTION_MODE = "WIFI" if wlan.isconnected() else "OFF"
    return CONNECTION_MODE == "WIFI"

def sync_time():
    global TIME_SYNCED
    if CONNECTION_MODE == "WIFI":
        try:
            ntptime.settime()
            TIME_SYNCED = True
            print("✅ ปรับเวลาเรียบร้อย")
        except:
            print("⚠️ ปรับเวลาไม่สำเร็จ")

def get_time():
    if TIME_SYNCED:
        t = time.localtime(time.time() + TIME_OFFSET)
        return f"{t[2]:02d}/{t[1]:02d}", f"{t[3]:02d}:{t[4]:02d}"
    return "--/--", "--:--"

# ==================================================
# 🧠 ระบบถาม-ตอบ AI
# ==================================================
def ask_ai(question):
    if CONNECTION_MODE != "WIFI":
        return "ต้องมีอินเทอร์เน็ตก่อน"
    if not GEMINI_API_KEY or len(GEMINI_API_KEY) < 10:
        return "คีย์ API ไม่ถูกต้อง"
    try:
        headers = {"Content-Type": "application/json"}
        data = {
            "contents": [{
                "parts": [{
                    "text": "ตอบสั้นๆ กระชับ ไม่เกิน 50 ตัวอักษร ภาษาไทย: " + question
                }]
            }]
        }
        res = urequests.post(GEMINI_URL, headers=headers, data=json.dumps(data), timeout=12)
        if res.status_code == 200:
            ans = res.json()["candidates"][0]["content"]["parts"][0]["text"].strip()
            res.close()
            return ans
        res.close()
        return "เชื่อมต่อไม่สำเร็จ"
    except Exception as e:
        print("ผิดพลาด:", e)
        return "เกิดข้อผิดพลาด"

