# 🧠 ระบบถาม-ตอบ AI
# ==================================================
def ask_ai(question):
    if CONNECTION_MODE != "WIFI":
        return "ต้องมีเน็ตก่อน"
    try:
        headers = {"Content-Type": "application/json"}
        data = {
            "contents": [{
                "parts": [{
                    "text": f"ตอบสั้นๆ กระชับ ไม่เกิน 50 ตัวอักษร ภาษาไทย: {question}"
                }]
            }]
        }
        res = urequests.post(GEMINI_URL, headers=headers, data=json.dumps(data), timeout=10)
        if res.status_code == 200:
            ans = res.json()["candidates"][0]["content"]["parts"][0]["text"].strip()
            res.close()
            return ans
        res.close()
        return "ตอบไม่ได้ชั่วคราว"
    except Exception as e:
        print(f"[Error]: {e}")
        return "เกิดข้อผิดพลาด"

