def detect_display_auto():
    global DISPLAY_TYPE, DISPLAY_ADDR, WIDTH, HEIGHT, buffer, fb
    print("[ระบบ] กำลังค้นหาจอ...")
    addrs = i2c.scan()
    print(f"[ระบบ] พบอุปกรณ์: {[hex(a) for a in addrs]}")

    # รองรับจอ 128x32 ที่คุณใช้
    for addr in [0x3C, 0x3D]:
        if addr in addrs:
            try:
                init = [
                    0xAE, 0xD5, 0x80, 0xA8, 0x1F, 0xD3, 0x00, 0x40,
                    0x8D, 0x14, 0x20, 0x00, 0xA1, 0xC8, 0xDA, 0x02,
                    0x81, 0x7F, 0xD9, 0xF1, 0xDB, 0x20, 0xA4, 0xA6, 0xAF
                ]
                for cmd in init:
                    i2c.writeto(addr, bytearray([0x80, cmd]))
                DISPLAY_TYPE = "OLED_128x32"
                DISPLAY_ADDR = addr
                WIDTH, HEIGHT = 128, 32
                buffer = bytearray(WIDTH * HEIGHT // 8)
                fb = framebuf.FrameBuffer(buffer, WIDTH, HEIGHT, framebuf.MONO_VLSB)
                print("✅ พบจอ OLED 128x32")
                return True
            except:
                pass
    print("❌ ไม่พบจอแสดงผล")
    return False

def update_display():
    if DISPLAY_TYPE == "OLED_128x32":
        for page in range(4):
            i2c.writeto(DISPLAY_ADDR, bytearray([0x80, 0xB0 + page, 0x00, 0x10]))
            i2c.writeto(DISPLAY_ADDR, b'\x40' + buffer[page*128 : (page+1)*128])

def clear_display():
    """ล้างหน้าจอให้สะอาดสนิท"""
    fb.fill(0)
    update_display()

