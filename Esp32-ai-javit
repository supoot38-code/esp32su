# 🧠 ระบบ AI อัจฉริยะ
# ==================================================
def ask_ai(question):
    if CONNECTION_MODE != "WIFI":
        return "ต้องเชื่อมต่ออินเทอร์เน็ตก่อน"
    try:
        print(f"[AI] ถาม: {question}")
        headers = {"Content-Type": "application/json"}
        data = {
            "contents": [{"parts": [{"text": f"ตอบสั้นๆ กระชับ ไม่เกิน 50 ตัวอักษร ภาษาไทย: {question}"}]}]
        }
        res = urequests.post(GEMINI_URL, headers=headers, data=json.dumps(data), timeout=10)
        if res.status_code == 200:
            result = res.json()
            answer = result["candidates"][0]["content"]["parts"][0]["text"].strip()
            res.close()
            print(f"[AI] ตอบ: {answer}")
            return answer
        else:
            res.close()
            return "ขอโทษ ตอบไม่ได้ตอนนี้"
    except Exception as e:
        print(f"[AI Error]: {e}")
        return "เกิดข้อผิดพลาดในการเชื่อมต่อ"

