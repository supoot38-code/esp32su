def detect_display_auto():
    global DISPLAY_TYPE, DISPLAY_ADDR, WIDTH, HEIGHT, buffer, fb
    print("[ระบบ] กำลังค้นหาจอแสดงผล...")
    found = False
    addrs = i2c.scan()
    print(f"[ระบบ] พบอุปกรณ์ I2C: {[hex(a) for a in addrs]}")

    # รองรับจอ OLED 128x32
    for addr in [0x3C, 0x3D]:
        if addr in addrs:
            try:
                init = [0xAE,0xD5,0x80,0xA8,0x1F,0xD3,0x00,0x40,
                        0x8D,0x14,0x20,0x00,0xA1,0xC8,0xDA,0x02,
                        0x81,0x7F,0xD9,0xF1,0xDB,0x20,0xA4,0xA6,0xAF]
                for cmd in init:
                    i2c.writeto(addr, bytearray([0x80, cmd]))
                DISPLAY_TYPE = "OLED_128x32"
                DISPLAY_ADDR = addr
                WIDTH, HEIGHT = 128, 32
                buffer = bytearray(WIDTH * HEIGHT // 8)
                fb = framebuf.FrameBuffer(buffer, WIDTH, HEIGHT, framebuf.MONO_VLSB)
                found = True
                print("✅ พบจอ OLED 128x32")
                break
            except:
                pass

    # รองรับจอ OLED 128x64
    if not found:
        for addr in [0x3C, 0x3D]:
            if addr in addrs:
                try:
                    init = [0xAE,0xD5,0x80,0xA8,0x3F,0xD3,0x00,0x40,
                            0x8D,0x14,0x20,0x02,0xA1,0xC8,0xDA,0x12,
                            0x81,0x7F,0xD9,0xF1,0xDB,0x20,0xA4,0xA6,0xAF]
                    for cmd in init:
                        i2c.writeto(addr, bytearray([0x80, cmd]))
                    DISPLAY_TYPE = "OLED_128x64"
                    DISPLAY_ADDR = addr
                    WIDTH, HEIGHT = 128, 64
                    buffer = bytearray(WIDTH * HEIGHT // 8)
                    fb = framebuf.FrameBuffer(buffer, WIDTH, HEIGHT, framebuf.MONO_VLSB)
                    found = True
                    print("✅ พบจอ OLED 128x64")
                    break
                except:
                    pass

    return found

def update_display():
    if DISPLAY_TYPE.startswith("OLED"):
        pages = HEIGHT // 8
        for p in range(pages):
            i2c.writeto(DISPLAY_ADDR, bytearray([0x80, 0xB0+p, 0x00, 0x10]))
            i2c.writeto(DISPLAY_ADDR, b'\x40' + buffer[p*WIDTH : (p+1)*WIDTH])

def clear_display():
    fb.fill(0)
    update_display()

def welcome_screen():
    clear_display()
    fb.text("🤖 AI JAVIT", 25, 0)
    fb.text("System Ready", 30, 16)
    update_display()
    time.sleep(2)

def draw_main_screen():
    clear_display()
    d, t = get_time_text()
    if DISPLAY_TYPE == "OLED_128x32":
        fb.text("AI JAVIT", 0, 0)
        fb.text(f"{d} {t}", 0, 8)
        fb.text(f"WiFi: {'ON' if CONNECTION_MODE=='WIFI' else 'OFF'}", 0, 20)
    update_display()

def draw_text_scroll(text, line=0):
    if len(text) <= 16:
        fb.text(text, 0, line)
        return
    for i in range(len(text)-14):
        fb.fill_rect(0, line, WIDTH, 8, 0)
        fb.text(text[i:i+16], 0, line)
        update_display()
        time.sleep(0.2)

