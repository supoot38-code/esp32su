# 📶 ระบบเชื่อมต่อ WiFi และเวลา
# ==================================================
def connect_wifi():
    global CONNECTION_MODE
    print("[ระบบ] กำลังเชื่อมต่อ WiFi...")
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        print(f"✅ เชื่อมต่อสำเร็จ: {wlan.ifconfig()}")
        return True
    wlan.connect(WIFI_SSID, WIFI_PASS)
    timeout = 10
    while not wlan.isconnected() and timeout > 0:
        time.sleep(1)
        timeout -= 1
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        return True
    else:
        CONNECTION_MODE = "OFF"
        print("❌ เชื่อมต่อ WiFi ไม่สำเร็จ")
        return False

def sync_time():
    global TIME_SYNCED
    if CONNECTION_MODE == "WIFI":
        try:
            ntptime.settime()
            TIME_SYNCED = True
            print("✅ ปรับเวลาประเทศไทยเรียบร้อย")
        except:
            print("⚠️ ไม่สามารถปรับเวลาได้")

def get_time_text():
    if TIME_SYNCED:
        t = time.localtime(time.time() + TIME_OFFSET)
        return f"{t[2]:02d}/{t[1]:02d}", f"{t[3]:02d}:{t[4]:02d}"
    return "--/--", "--:--"

