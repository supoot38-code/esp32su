def draw_scroll_text(text, y=8):
    """แสดงข้อความยาวแบบเลื่อน"""
    if len(text) <= 16:
        fb.text(text, 0, y)
        update_display()
        return
    for i in range(len(text) - 14):
        fb.fill_rect(0, y, WIDTH, 8, 0)
        fb.text(text[i:i+16], 0, y)
        update_display()
        time.sleep(0.2)

# ==================================================
# 📶 ระบบเชื่อมต่อและเวลา
# ==================================================
def connect_wifi():
    global CONNECTION_MODE
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        return True
    print("[WiFi] กำลังเชื่อมต่อ...")
    wlan.connect(WIFI_SSID, WIFI_PASS)
    timeout = 10
    while not wlan.isconnected() and timeout > 0:
        time.sleep(1)
        timeout -= 1
    if wlan.isconnected():
        CONNECTION_MODE = "WIFI"
        print(f"✅ เชื่อมต่อสำเร็จ IP: {wlan.ifconfig()[0]}")
        return True
    else:
        CONNECTION_MODE = "OFF"
        print("❌ เชื่อมต่อไม่ได้")
        return False

def sync_time():
    global TIME_SYNCED
    if CONNECTION_MODE == "WIFI":
        try:
            ntptime.settime()
            TIME_SYNCED = True
            print("✅ ปรับเวลาเรียบร้อย")
        except:
            print("⚠️ ปรับเวลาไม่สำเร็จ")

def get_time_text():
    if TIME_SYNCED:
        t = time.localtime(time.time() + TIME_OFFSET)
        return f"{t[2]:02d}/{t[1]:02d}", f"{t[3]:02d}:{t[4]:02d}"
    return "--/--", "--:--"

