def start_scan():
    print("=== เริ่มสแกนหาขาและรุ่นจออัตโนมัติ ===")
    print("💡 สังเกต: เมื่อไหร่เห็นสีแดงขึ้นมา แสดงว่าเจอค่าที่ถูกต้องแล้วครับ\n")
    for p_set in PIN_SETS:
        for d in DRIVERS:
            test_one(p_set, d)
    print("\n=== สแกนครบทุกรายการแล้ว ===")

if __name__ == "__main__":
    start_scan()
