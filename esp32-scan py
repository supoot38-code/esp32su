# ==================================================
# 🛠️ ฟังก์ชันพื้นฐาน
# ==================================================
def lcd_cmd(spi, cs, dc, cmd):
    dc.value(0)
    cs.value(0)
    spi.write(bytes([cmd]))
    cs.value(1)

def lcd_data(spi, cs, dc, data):
    dc.value(1)
    cs.value(0)
    if isinstance(data, int):
        spi.write(bytes([data]))
    elif isinstance(data, (list, tuple)):
        spi.write(bytes(data))
    elif isinstance(data, bytes):
        spi.write(data)
    cs.value(1)

def fill_test(spi, cs, dc, w, h, color_mode):
    lcd_cmd(spi, cs, dc, 0x2A)
    lcd_data(spi, cs, dc, [0,0, (w-1)>>8, (w-1)&0xFF])
    lcd_cmd(spi, cs, dc, 0x2B)
    lcd_data(spi, cs, dc, [0,0, (h-1)>>8, (h-1)&0xFF])
    lcd_cmd(spi, cs, dc, 0x2C)

    if color_mode == "16bit":
        buf = b'\xF8\x00' * w  # สีแดง 16 บิต
    else:
        buf = b'\xFF\x00\x00' * w  # สีแดง 18 บิต

    cs.value(0)
    dc.value(1)
    for _ in range(h):
        spi.write(buf)
    cs.value(1)

# ==================================================
# 🔍 ทดลองแต่ละชุด
# ==================================================
def test_one(pins, drv):
    print(f"\n--- ทดลอง: {pins['note']} | รุ่น: {drv['name']} ---")
    try:
        cs   = Pin(pins["cs"],  Pin.OUT, 1)
        rst  = Pin(pins["rst"], Pin.OUT, 1)
        dc   = Pin(pins["dc"],  Pin.OUT, 0)
        sck  = Pin(pins["sck"], Pin.OUT)
        mosi = Pin(pins["mosi"],Pin.OUT, 0)
        bl   = Pin(pins["bl"],  Pin.OUT, 0)

        spi = SPI(1, baudrate=6_000_000, polarity=0, phase=0,
                  firstbit=SPI.MSB, sck=sck, mosi=mosi)

        # รีเซ็ต
        rst.value(0); time.sleep_ms(50)
        rst.value(1); time.sleep_ms(200)

        # เริ่มต้นจอ
        for cmd, val in drv["init"]:
            lcd_cmd(spi, cs, dc, cmd)
            if isinstance(val, int) and val > 10:
                time.sleep_ms(val)
            elif val is not None:
                lcd_data(spi, cs, dc, val)
                time.sleep_ms(5)

        # เปิดไฟหลังจอและทาสี
        bl.value(1)
        time.sleep_ms(50)
        fill_test(spi, cs, dc, drv["w"], drv["h"], drv["color"])

        print(f"✅ เสร็จชุดนี้ → ดูที่จอ ถ้าเห็นสีแดง แปลว่าเจอแล้ว!")
        print(f"💡 ขา: CS={pins['cs']}, RST={pins['rst']}, DC={pins['dc']}, SCK={pins['sck']}, MOSI={pins['mosi']}, BL={pins['bl']}")
        print(f"💡 ชิป: {drv['name']}, สี: {drv['color']}")
        time.sleep(2)

        # ปิดก่อนชุดถัดไป
        bl.value(0)
        rst.value(0); time.sleep_ms(30)
        rst.value(1); time.sleep_ms(50)

    except Exception as e:
        print(f"❌ ข้ามชุดนี้: {e}")
        time.sleep_ms(50)

