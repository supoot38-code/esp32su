# ======================================
# 3. ฟังก์ชันพื้นฐานส่งคำสั่ง/ข้อมูล
# ======================================
def lcd_cmd(spi, cs, dc, cmd):
    dc.value(0)
    cs.value(0)
    spi.write(bytes([cmd]))
    cs.value(1)

def lcd_data(spi, cs, dc, data):
    dc.value(1)
    cs.value(0)
    if isinstance(data, int):
        spi.write(bytes([data]))
    elif isinstance(data, (list, tuple)):
        spi.write(bytes(data))
    elif isinstance(data, bytes):
        spi.write(data)
    cs.value(1)

def fill_color(spi, cs, dc, width, height, color_mode):
    """ทาสีแดงเต็มจอเพื่อตรวจสอบว่าทำงานได้"""
    lcd_cmd(spi, cs, dc, 0x2C)
    cs.value(0)
    dc.value(1)
    if color_mode == "RGB16":
        buf = bytes([0xF8, 0x00]) * width   # สีแดง 16 บิต
    else:
        buf = bytes([0xFF, 0x00, 0x00]) * width  # สีแดง 18 บิต
    for _ in range(height):
        spi.write(buf)
    cs.value(1)

# ======================================
# 4. ฟังก์ชันทดลองชุดขา + รุ่นจอ
# ======================================
def test_combination(pins, driver):
    print(f"\n--- ทดลอง: {pins['desc']} | รุ่น: {driver['name']} ---")
    try:
        # สร้างขา
        cs   = Pin(pins["cs"],  Pin.OUT, value=1)
        rst  = Pin(pins["rst"], Pin.OUT, value=1)
        dc   = Pin(pins["dc"],  Pin.OUT, value=0)
        sck  = Pin(pins["sck"], Pin.OUT)
        mosi = Pin(pins["mosi"],Pin.OUT, value=0)
        bl   = Pin(pins["bl"],  Pin.OUT, value=0)

        # ตั้งค่า SPI
        spi = SPI(1, baudrate=6_000_000, polarity=0, phase=0, firstbit=SPI.MSB,
                  sck=sck, mosi=mosi)

        # รีเซ็ตจอ
        rst.value(0); time.sleep_ms(50)
        rst.value(1); time.sleep_ms(200)

        # ส่งชุดคำสั่งเริ่มต้น
        for cmd, content in driver["init"]:
            lcd_cmd(spi, cs, dc, cmd)
            if isinstance(content, int) and content > 20:
                time.sleep_ms(content)
            elif content is not None:
                lcd_data(spi, cs, dc, content)
                time.sleep_ms(10)

        # เปิดไฟหลังจอ
        bl.value(1)
        time.sleep_ms(100)

        # ทาสีแดงเพื่อตรวจสอบ
        fill_color(spi, cs, dc, driver["w"], driver["h"], driver["color_mode"])
        print(f"✅ ทดสอบเสร็จ ดูที่จอ: ถ้าเห็นสีแดง = สำเร็จแล้ว!")
        print(f"🔍 ขา: CS={pins['cs']}, RST={pins['rst']}, DC={pins['dc']}, SCK={pins['sck']}, MOSI={pins['mosi']}, BL={pins['bl']}")
        print(f"🔍 รุ่นจอ: {driver['name']}, รูปแบบสี: {driver['color_mode']}")
        time.sleep(3)  # รอให้สังเกตเห็นชัดๆ

        # คืนค่าเริ่มต้นก่อนทดลองชุดถัดไป
        bl.value(0)
        rst.value(0); time.sleep_ms(50)
        rst.value(1); time.sleep_ms(100)

    except Exception as e:
        print(f"❌ ข้ามชุดนี้ได้: {e}")
        time.sleep_ms(100)

# ======================================
# 5. เริ่มสแกนทั้งหมด
# ======================================
def auto_scan_all():
    print("=== เริ่มสแกนอัตโนมัติ ทุกชุดขา + ทุกรุ่นจอ ===")
    for pin_set in PIN_COMBINATIONS:
        for drv in DISPLAY_DRIVERS:
            test_combination(pin_set, drv)
    print("\n=== สแกนครบทุกรายการแล้ว ===")
    print("💡 ถ้าช่วงไหนเห็นสีแดง/สีต่างๆ ไม่ใช่สีขาว จดชุดขาและรุ่นนั้นไว้ใช้ต่อได้เลย")

# รัน
if __name__ == "__main__":
    auto_scan_all()
